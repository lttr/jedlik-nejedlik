# --- Runtime ---
# The app needs these to boot. web/server/runtime-config.schema.ts validates them.

NUXT_PUBLIC_DIRECTUS_URL=https://example.com
NUXT_PUBLIC_COURSES_PUBLIC=true

# Encrypts the session cookie. Changing it signs everyone out. At least 32
# characters: `openssl rand -base64 32`.
NUXT_SESSION_PASSWORD=

# --- Tools ---
# Credentials of the permanent [TEST] users on the Directus instance. The app
# never reads them. Tokens drive `vp run directus:probe`, and the admin one also
# `directus:pull` and `directus:diff`. E-mails and the shared password are for
# signing in as these users by hand. See docs/directus.md, Test accounts.

DIRECTUS_PROBE_PASSWORD=
DIRECTUS_PROBE_ADMIN_TOKEN=
DIRECTUS_PROBE_AUTHOR_EMAIL=
DIRECTUS_PROBE_AUTHOR_TOKEN=
DIRECTUS_PROBE_STUDENT_ENTITLED_EMAIL=
DIRECTUS_PROBE_STUDENT_ENTITLED_TOKEN=
DIRECTUS_PROBE_STUDENT_UNENTITLED_EMAIL=
DIRECTUS_PROBE_STUDENT_UNENTITLED_TOKEN=
