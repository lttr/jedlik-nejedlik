# Directus instance the site reads content from. Public: exposed to the browser.
NUXT_PUBLIC_DIRECTUS_URL=https://example.com

# Seals the session cookie (nuxt-auth-utils). At least 32 chars —
# `openssl rand -base64 32`. Rotating it logs every Student out.
NUXT_SESSION_PASSWORD=

# Admin-capable static token for `vp run directus:pull` / `directus:diff`. Same
# credential as the Directus MCP server (`claude mcp get directus` prints it).
# If unset, the tasks fall back to DIRECTUS_PROBE_ADMIN_TOKEN below.
DIRECTUS_TOKEN=

# Permission probes (`vp run directus:probe`), docs/directus.md → Tokens. The
# admin one is the same credential as DIRECTUS_TOKEN, used for fixtures and
# cleanup; the other three are the fixture probe users' static tokens.
DIRECTUS_PROBE_ADMIN_TOKEN=
DIRECTUS_PROBE_AUTHOR_TOKEN=
DIRECTUS_PROBE_STUDENT_ENTITLED_TOKEN=
DIRECTUS_PROBE_STUDENT_UNENTITLED_TOKEN=
