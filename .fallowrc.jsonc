{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // certificate/ is a standalone vanilla-JS cert renderer — app.js is its root.
  // (Knip listed the same file as a `.` workspace entry.)
  "entry": [
    "certificate/app.js",
    // Nuxt layers under web/layers/ are auto-registered (pages routed,
    // utils/shared auto-imported) — fallow's Nuxt detection only covers
    // the root app dir, so layer files look unreachable without this.
    "web/layers/*/nuxt.config.ts",
    "web/layers/*/app/**",
    "web/layers/*/shared/**",
    "web/layers/*/server/**",
    // Test-runner configs invoked by their own task, never imported.
    "web/vitest.*.config.ts",
    "web/tests/probes/**",
    // Read by the directus-sync CLI (directus:pull/diff tasks), never imported.
    "directus/sync.config.cjs",
    // Loaded by @lttr/nuxt-validated-runtime-config via path convention.
    "web/server/runtime-config.schema.ts",
  ],

  "ignorePatterns": [
    // Archived pages kept for reference, not wired into the app (Knip: `!archive/**`).
    "web/archive/**",
    // certificate CSS is <link>-ed from generated HTML, never JS-imported —
    // fallow's CSS analysis can't see the reference.
    "certificate/**/*.css",
    // Directus hook extensions: loaded by the Directus API on the instance
    // (see docs/directus.md), never imported by anything in this repo.
    "directus/extensions/**",
  ],

  "ignoreDependencies": [
    // TS language-service plugin (tsconfig compilerOptions.plugins).
    "@dxup/unimport",
    // Icon collections referenced by name string, resolved by @nuxt/icon.
    "@iconify-json/bi",
    "@iconify-json/logos",
    "@iconify-json/uil",
    // Peer of @vueuse/nuxt.
    "@vueuse/core",
    // Transitive: provided by eslint config, imported directly.
    "eslint-plugin-es-x",
    // Nuxt module registered via a conditional string in nuxt.config.ts
    // (production only) — not statically traceable.
    "@nuxtjs/plausible",
    // CLI-only, invoked by the directus:pull/diff tasks, never imported.
    "directus-sync",
  ],

  // Layers form a stack and imports only point down it:
  // app (root) → mock-gopay → shop → auth → directus → base.
  // A layer never imports from one above it, from a sibling, or from the root.
  "boundaries": {
    "zones": [
      { "name": "app", "patterns": ["web/app/**"] },
      // Before `layers`: the first match wins, so this carves the nested layer
      // out of `layers/shop`.
      { "name": "mock-gopay", "patterns": ["web/layers/shop/mock-gopay/**"] },
      // No `patterns` on the parent: every file lands in a child, and a parent
      // pattern that matches 0 files warns on every run.
      { "name": "layers", "autoDiscover": ["web/layers"] },
    ],
    "rules": [
      { "from": "app", "allow": ["layers"] },
      { "from": "layers/base", "allow": [] },
      { "from": "layers/directus", "allow": ["layers/base"] },
      { "from": "layers/auth", "allow": ["layers/base", "layers/directus"] },
      { "from": "layers/shop", "allow": ["layers/base", "layers/directus", "layers/auth"] },
      {
        "from": "mock-gopay",
        "allow": ["layers/base", "layers/directus", "layers/auth", "layers/shop"],
      },
    ],
  },

  "rules": {
    "boundary-violation": "warn",
    // catalog `vite` is consumed via pnpm-workspace.yaml `overrides`, not a
    // `catalog:` specifier — the only form these checks trace.
    "unused-catalog-entries": "off",
    "unused-dependency-overrides": "off",
  },

  // Complexity gates. Become the primary complexity enforcement if the
  // eslint `complexity` rule is ever dropped.
  "health": {
    "maxCyclomatic": 8,
    "maxCognitive": 8,
    // CRAP needs real coverage data; without `fallow --coverage` it assumes
    // 0% untested and inflates. Set out of reach so it can never gate.
    "maxCrap": 1000,
  },

  // `fallow audit` (run by the pre-commit hook) gates on every finding in
  // changed files, not just newly-introduced ones.
  "audit": {
    "gate": "all",
  },
}
