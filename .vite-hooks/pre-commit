# Run under `sh -e`: the first failure aborts the commit.

# Advises: grades staged comments and prints findings. Runs before the gate so
# its output is seen even when the gate fails. Never blocks.
if command -v lint-comments >/dev/null 2>&1; then
  lint-comments --staged --format text || true
fi

# Writes: formats and --fixes staged files, then re-stages them. Scoped to
# the index on purpose — it must not rewrite files you did not stage.
vp staged

# Judges: the whole gate, read-only over the repo. Not redundant with the
# pass above — lint is type-aware, so editing a staged file can break an
# unstaged caller that a scoped pass never looks at.
vp run check:all
