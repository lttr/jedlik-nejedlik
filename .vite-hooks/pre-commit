# Run under `sh -e`: the first failure aborts the commit.

# Advises: grades staged comments. Never blocks. Graded before `vp staged`
# rewrites the index, but printed on exit, pass or fail, so the findings are
# the last thing in the output: a truncated log still carries them. The file
# keeps them for reading after the commit.
if command -v lint-comments >/dev/null 2>&1; then
  findings="$(git rev-parse --git-dir)/lint-comments.txt"
  lint-comments --staged --format text >"$findings" 2>&1 || true
  trap 'echo "--- lint-comments ($findings) ---"; cat "$findings"' EXIT
fi

# Writes: formats and --fixes staged files, then re-stages them. Scoped to
# the index on purpose — it must not rewrite files you did not stage.
vp staged

# Judges: the whole gate, read-only over the repo. Not redundant with the
# pass above — lint is type-aware, so editing a staged file can break an
# unstaged caller that a scoped pass never looks at.
vp run check:all
